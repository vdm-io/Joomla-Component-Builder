		<field
			type="plugins"
			name="compiler_plugin"
			label="COM_COMPONENTBUILDER_CONFIG_COMPILER_PLUGIN_LABEL"
			description="COM_COMPONENTBUILDER_CONFIG_COMPILER_PLUGIN_DESCRIPTION"
			multiple="true"
			folder="extension"
			filter="cmd"
