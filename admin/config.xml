			name="editor"
			label="COM_COMPONENTBUILDER_CONFIG_EDITOR_LABEL"
			default="none"
			description="COM_COMPONENTBUILDER_CONFIG_EDITOR_DESCRIPTION"
			folder="editors"
			filter="cmd"
		/>
