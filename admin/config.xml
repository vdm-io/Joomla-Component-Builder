			buttons="add,remove,move"
			description="COM_COMPONENTBUILDER_CONFIG_SUBFORM_LAYOUTS_DESCRIPTION"
			icon="list"
			max="10"
			min="1">
			<form hidden="true" name="list_subform_layouts_modal" repeat="true">
