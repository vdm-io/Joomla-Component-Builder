			maxlength="30"
			default=""
			description="COM_COMPONENTBUILDER_CONFIG_MENU_PREFIX_DESCRIPTION"
			class="text_area"
			filter="SAFEHTML"
			message="COM_COMPONENTBUILDER_CONFIG_MENU_PREFIX_MESSAGE"
			hint="COM_COMPONENTBUILDER_CONFIG_MENU_PREFIX_HINT"
